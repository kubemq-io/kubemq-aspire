<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KubeMQ.Aspire.Client</PackageId>
    <Description>KubeMQ client integration for .NET Aspire. Configures IKubeMQClient with health checks, OpenTelemetry, and keyed DI support.</Description>
    <PackageTags>aspire;integration;kubemq;messaging;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KubeMQ.SDK.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="ConfigurationSchema.json" />
  </ItemGroup>
</Project>
